# Copy to .env in THIS project directory. Never put keys in commands or prompts.
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest

# Only needed for autonomous `run`, not `select`, `session`, or the mock demo.
# Provider and model must be supported by the pinned pi-ai package.
ROOT_PROVIDER=xai
ROOT_MODEL=grok-4.7
ROOT_API_KEY=

# Optional hard ceilings per run (not monetary budgets).
MAX_STEPS=12
MAX_JEV_REQUESTS=20
CELL_TIMEOUT_MS=120000
